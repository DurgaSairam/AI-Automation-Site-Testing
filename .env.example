# Environment Configuration for Automated Testing Suite
# Copy this file to .env and update with your values

# ============================================
# WEBSITE CONFIGURATION
# ============================================

# The URL to test (staging or production)
# Examples:
#   TEST_URL=https://mcstaging.fantasyworldtoys.com
#   TEST_URL=https://fantasyworldtoys.com
TEST_URL=https://mcstaging.fantasyworldtoys.com

# ============================================
# NOTIFICATION SETTINGS (Optional)
# ============================================

# Slack webhook for notifications
# Get from: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for notifications
# Get from: Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# Email notifications (requires nodemailer setup)
# EMAIL_NOTIFICATION=your-email@example.com
# EMAIL_USER=smtp-user@gmail.com
# EMAIL_PASSWORD=your-app-password

# ============================================
# WEBHOOK SECURITY (For webhook-listener.js)
# ============================================

# Secret key for webhook signature verification
# Generate with: openssl rand -hex 32
# WEBHOOK_SECRET=your-random-secret-key-here

# Port for webhook listener
# PORT=3000

# ============================================
# TESTING CONFIGURATION (Optional)
# ============================================

# Maximum pages to test (default: 100)
# MAX_PAGES=50

# Page load timeout in milliseconds (default: 30000)
# TIMEOUT=60000

# Enable/disable screenshots on errors (default: true)
# SCREENSHOT_ON_ERROR=false
